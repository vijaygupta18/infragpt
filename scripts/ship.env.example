# Deployment coordinates for scripts/ship.sh.
#
# Copy to scripts/ship.env (gitignored) and fill in. Nothing here is secret,
# but it identifies a specific deployment, so it is kept out of the repository.

# Container registry path the image is pushed to.
REPO="<REGION>-docker.pkg.dev/<GCP_PROJECT>/infragpt/infragpt"

# kubectl context to deploy into. Always passed explicitly — never
# `kubectl config use-context`, which silently changes what a later command
# targets.
CTX="<KUBECTL_CONTEXT>"

# Namespace.
NS="<NAMESPACE>"
